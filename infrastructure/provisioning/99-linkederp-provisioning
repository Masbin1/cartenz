# LinkedERP project provisioning — sudoers rule (ADR-039)
#
# Installs on the host as root:
#
#   visudo -cf infrastructure/provisioning/99-linkederp-provisioning   # validate first
#   install -o root -g root -m 0440 \
#     infrastructure/provisioning/99-linkederp-provisioning \
#     /etc/sudoers.d/99-linkederp-provisioning
#
# What this grants, and nothing more:
#
#   - The "cartenz" user (the one the LinkedERP API and worker run as) may run
#     exactly six commands as root, with NO password prompt (NOPASSWD) and
#     no other privilege.
#   - Two are the operator's own project-creation scripts, called with no
#     wildcard in their arguments: the platform's own CommandRunner
#     (backend/src/core/process/command-runner.service.ts,
#     assertProvisioningInvocation) independently re-validates that only these
#     two exact paths are ever passed to `sudo`, and that the arguments after
#     them are a valid project name, a valid port and — optionally, since
#     ADR-045 — a valid Odoo version the scripts use to select the
#     full-installation template database (built by
#     infrastructure/provisioning/build-odoo-templates.sh and duplicated by
#     infrastructure/provisioning/create-project-db.sh). This sudoers rule and
#     that code-level check are two independent gates; neither is trusted
#     alone.
#   - The third is the addons/ ownership fix-up
#     (infrastructure/provisioning/grant-addons-write.sh), needed because
#     create_project/create_project_enterprise leave the whole project
#     directory, including addons/, owned by odoo:odoo mode 750 — unwritable
#     by the "cartenz" user that must git-init and commit into addons/.
#   - The fourth is HTTPS issuance for a freshly provisioned project (ADR-040):
#     infrastructure/provisioning/setup-project-https.sh runs
#     `certbot --nginx` for the project's own domain, non-interactively, using
#     the operator's configured PROJECT_HTTPS_EMAIL. It refuses to run against
#     any domain that is not already the server_name in that project's own
#     Nginx site.
#
#   - The fifth is the project pull (ADR-049):
#     infrastructure/provisioning/pull-project.sh brings a project's instance
#     up to date with its own repository — the thing ADR-041 left one-way, where
#     the platform could push to a project's GitHub repository but nothing ever
#     pulled. It calls `sudo -u odoo` internally so the checkout stays owned by
#     the user Odoo runs as, and takes an optional credential on stdin so no
#     token ever appears in argv.
#
#   - The sixth is the ephemeral preview (ADR-052):
#     infrastructure/provisioning/preview-project.sh builds a short-lived Odoo
#     from a task's retained draft so a reviewer sees the real UI before
#     approving. It takes only `start|stop <project-name> <ref>`; the job file
#     and patch are read from a fixed staging directory, never from an argument,
#     and the git credential arrives on stdin as the pull's does.
#
#   - The seventh is the per-client backup (ADR-054):
#     infrastructure/provisioning/backup-project.sh snapshots one project's
#     database, filestore and addons repository before a push onto a staging (or
#     main-named) branch. It takes only `<project-name>`, reads the database name
#     from the project's own odoo.conf, and writes under /opt/odoo/backups. The
#     matching restore (restore-project.sh) is deliberately NOT here: it is an
#     operator's tool, run directly as root, so custody of the backup and custody
#     of the platform stay separable.
#
#   - The eighth is the installed-modules read (ADR-056):
#     infrastructure/provisioning/list-installed-modules.sh returns what is
#     actually installed in one project's own database — `SELECT name, state
#     FROM ir_module_module`, a single fixed query, against exactly the database
#     that project's own odoo.conf names. The platform has no database
#     connection of its own (verified: the "cartenz" role gets `permission
#     denied for table ir_module_module`), and this is the narrow alternative to
#     granting one. It takes only `<project-name>`; nothing in the argument
#     vector can choose a database, a table or a write.
#
#   - `sudo -l -U cartenz` on the host shows exactly this rule; there is no
#     wildcard sudo access anywhere else for this user.
#
# Update the paths below if this repository, or the operator's scripts,
# live somewhere other than what ADR-039/ADR-040 assumes.

Cmnd_Alias LINKEDERP_PROVISION = \
    /opt/odoo/scripts/create_project, \
    /opt/odoo/scripts/create_project_enterprise, \
    /opt/cartenz/infrastructure/provisioning/grant-addons-write.sh, \
    /opt/cartenz/infrastructure/provisioning/setup-project-https.sh, \
    /opt/cartenz/infrastructure/provisioning/pull-project.sh, \
    /opt/cartenz/infrastructure/provisioning/preview-project.sh, \
    /opt/cartenz/infrastructure/provisioning/backup-project.sh, \
    /opt/cartenz/infrastructure/provisioning/list-installed-modules.sh

cartenz ALL=(root) NOPASSWD: LINKEDERP_PROVISION

# Never let sudo re-exec these under a pty or with an inherited environment
# that could smuggle something in; !requiretty is deliberately NOT set here —
# CommandRunner's sudo invocations always pass -n (non-interactive), so a TTY
# is never expected. Defaults below are the same hardening the platform itself
# applies to every child process (see command-runner.service.ts FORCED_ENV):
# no explicit Defaults line is required for a NOPASSWD Cmnd_Alias grant, but
# the two are stated for a reader auditing this file, not enforced by it.
