#!/usr/bin/env bash
set -Eeuo pipefail

# ============================================================
# LinkedERP - reference create_project (Community) — ADR-039, ADR-045
# ============================================================
#
# This is a REFERENCE implementation of the operator's provisioning script.
# It implements the contract the platform depends on (ADR-039/040):
#
#   - runs as root via the narrow sudoers rule (99-linkederp-provisioning)
#   - args: <project-name> <http-port> [<odo version>]
#   - creates /opt/odoo/projects/<name>/{addons,config,data,logs}, all
#     chown'd odoo:odoo mode 750 (addons/ is later made group-writable by
#     grant-addons-write.sh)
#   - creates the PostgreSQL database, the systemd unit, and the Nginx site
#   - prints the Odoo master password in the exact block the platform parses
#
# The one change from the pre-ADR-045 script is the database step: when a
# version is given, the database is DUPLICATED from the full-installation
# template (every module installed) instead of running `odoo-bin -i base`.
# Without a version it behaves exactly as before.
#
# Adapt the variables under "Host configuration" to your host, and keep the
# rest of the contract identical, because the platform's
# assertProvisioningInvocation and parseMasterPassword rely on it.
#
# Usage:
#   create_project <project-name> <http-port> [<odo version>]
#
# Example:
#   create_project dodolbintangmas 7001 19.0
#
# The gevent/websocket worker is <http-port> + 1, which is how the platform
# allocates ports (ProjectProvisioningService.allocatePort).
# ============================================================

# --- Host configuration (adapt these) -------------------------------
BASE_DIR="/opt/odoo"
PROJECTS_DIR="${BASE_DIR}/projects"
SCRIPTS_DIR="${BASE_DIR}/scripts"
ODOO_BASE="/opt/odoo/versions/19.0/odoo"          # repo root holding odoo-bin
ODOO_PYTHON="/opt/odoo/venv19/bin/python"          # interpreter that imports odoo
BASE_DOMAIN="masbintang.space"                     # <name>.<base_domain>
ODOO_USER="odoo"                                   # Postgres role + system user
DB_HOST="127.0.0.1"
DB_PORT="5432"
# --------------------------------------------------------------------

usage() {
    echo
    echo "Usage:"
    echo "  create_project <project-name> <http-port> [<odo version>]"
    echo
    exit 1
}

if [[ "$EUID" -ne 0 ]]; then
    echo "ERROR: This script must be run as root." >&2
    exit 1
fi

if [[ $# -lt 2 || $# -gt 3 ]]; then
    usage
fi

PROJECT_NAME="$1"
HTTP_PORT="$2"
VERSION="${3:-}"

if [[ ! "$PROJECT_NAME" =~ ^[a-z0-9][a-z0-9_-]{1,30}$ ]]; then
    echo "ERROR: Invalid project name." >&2
    exit 1
fi

if [[ ! "$HTTP_PORT" =~ ^[0-9]+$ || "$HTTP_PORT" -lt 1024 || "$HTTP_PORT" -gt 65534 ]]; then
    echo "ERROR: Invalid HTTP port." >&2
    exit 1
fi

if [[ -n "$VERSION" && ! "$VERSION" =~ ^[0-9]+\.[0-9]+$ ]]; then
    echo "ERROR: Invalid Odoo version '${VERSION}'." >&2
    exit 1
fi

GEVENT_PORT=$((HTTP_PORT + 1))
PROJECT_DIR="${PROJECTS_DIR}/${PROJECT_NAME}"
CONF_DIR="${PROJECT_DIR}/config"

if [[ -d "$PROJECT_DIR" ]]; then
    echo "ERROR: ${PROJECT_DIR} already exists." >&2
    exit 1
fi

# --- 1. Directory skeleton -------------------------------------------
mkdir -p "${PROJECT_DIR}"/{addons,config,data,logs}

# --- 2. Database: template duplication (ADR-045) or base install ------
# The DB step is delegated so the operator has one place that knows the
# template names and neutralisation rules. Community templates hold every
# Community module; enterprise templates (create_project_enterprise) add the
# enterprise set.
if [[ -n "$VERSION" ]]; then
    URL="https://${PROJECT_NAME}.${BASE_DOMAIN}"
    "${SCRIPTS_DIR}/create-project-db.sh" "$PROJECT_NAME" community "$VERSION" "$URL"
else
    # Pre-ADR-045 behaviour: empty database, base only. Keep for deployments
    # that have not built templates yet.
    sudo -u postgres createdb -O "$ODOO_USER" "$PROJECT_NAME"
    PGPASSWORD=odoo "$ODOO_PYTHON" "${ODOO_BASE}/odoo-bin" \
        -d "$PROJECT_NAME" \
        --db_host "$DB_HOST" --db_port "$DB_PORT" --db_user "$ODOO_USER" \
        -i base --stop-after-init --no-http
fi

# --- 3. Master password + odoo.conf -----------------------------------
# admin_passwd is the Odoo master password the platform seals; db_password is
# what the instance's own odoo.conf uses. Neither is logged.
MASTER_PASSWORD="$(openssl rand -hex 16)"
DB_PASSWORD="$(openssl rand -hex 16)"

ADDONS_PATH="${ODOO_BASE}/addons,${PROJECT_DIR}/addons"

cat > "${CONF_DIR}/odoo.conf" <<EOF
[options]
addons_path = ${ADDONS_PATH}
db_name = ${PROJECT_NAME}
db_host = ${DB_HOST}
db_port = ${DB_PORT}
db_user = ${ODOO_USER}
db_password = ${DB_PASSWORD}
admin_passwd = ${MASTER_PASSWORD}
http_interface = 127.0.0.1
http_port = ${HTTP_PORT}
gevent_port = ${GEVENT_PORT}
data_dir = ${PROJECT_DIR}/data
logfile = ${PROJECT_DIR}/logs/odoo.log
EOF

# --- 4. systemd unit ---------------------------------------------------
cat > "/etc/systemd/system/odoo-${PROJECT_NAME}.service" <<EOF
[Unit]
Description=Odoo ${PROJECT_NAME}
After=network.target postgresql.service

[Service]
Type=simple
User=${ODOO_USER}
Group=${ODOO_USER}
ExecStart=${ODOO_PYTHON} ${ODOO_BASE}/odoo-bin -c ${CONF_DIR}/odoo.conf
Restart=on-failure
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
EOF

# --- 5. Nginx site ------------------------------------------------------
cat > "/etc/nginx/sites-available/${PROJECT_NAME}" <<EOF
server {
    listen 80;
    server_name ${PROJECT_NAME}.${BASE_DOMAIN};

    location / {
        proxy_pass http://127.0.0.1:${HTTP_PORT};
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;
        proxy_http_version 1.1;
        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 300s;
    }
}
EOF
ln -sf "/etc/nginx/sites-available/${PROJECT_NAME}" "/etc/nginx/sites-enabled/${PROJECT_NAME}"

# --- 6. Ownership -------------------------------------------------------
# The whole directory is odoo:odoo mode 750; grant-addons-write.sh (run by the
# platform next) narrows addons/ so the platform user can git-init into it.
chown -R "${ODOO_USER}:${ODOO_USER}" "$PROJECT_DIR"
chmod 750 "$PROJECT_DIR" "$CONF_DIR" "${PROJECT_DIR}/data" "${PROJECT_DIR}/logs"
chmod 640 "${CONF_DIR}/odoo.conf"

# --- 7. Bring it up ------------------------------------------------------
systemctl daemon-reload
systemctl enable --now "odoo-${PROJECT_NAME}.service" >/dev/null
nginx -t >/dev/null 2>&1 && systemctl reload nginx >/dev/null || true

# --- 8. The contract output ---------------------------------------------
# The exact block parseMasterPassword looks for. Do not reword it.
cat <<EOF

Odoo Master Password:

  ${MASTER_PASSWORD}

Project:   ${PROJECT_NAME}
Database:  ${PROJECT_NAME}
URL:       https://${PROJECT_NAME}.${BASE_DOMAIN}
Port:      ${HTTP_PORT}
EOF
