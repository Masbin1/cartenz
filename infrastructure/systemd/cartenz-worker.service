[Unit]
# Cartenz agent worker — consumes the BullMQ queue and runs agent tasks.
# Separate unit from the API because it is the process that clones repositories
# and calls model providers; it is restarted and scaled independently (ADR-016).
Description=Cartenz agent worker
Documentation=file:///opt/cartenz/docs/INSTALL-SERVER.md
After=network-online.target postgresql.service redis-server.service cartenz-api.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=cartenz
Group=cartenz
WorkingDirectory=/opt/cartenz/backend
EnvironmentFile=/opt/cartenz/.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node dist/worker.js
Restart=always
RestartSec=5

# The worker clones into WORKSPACE_ROOT and must be able to write there, and — when
# project provisioning is enabled — to the paths the operator's create_project script
# writes through this unit. This unit is the one that actually runs tasks, so it is
# the one provisioning fails from; the list is identical to cartenz-api.service's for
# that reason, and the reasoning (including why the no-new-privs-implying directives
# are absent) is documented there.
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/cartenz/.runtime /var/log/cartenz /opt/odoo/projects /etc/systemd/system /etc/nginx/sites-available /etc/nginx/sites-enabled /var/log/nginx
ProtectControlGroups=true

StandardOutput=append:/var/log/cartenz/worker.log
StandardError=append:/var/log/cartenz/worker.log

[Install]
WantedBy=multi-user.target
