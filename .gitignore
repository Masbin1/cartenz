# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
build/
.next/
out/
*.tsbuildinfo
# Damaged build trees renamed aside during a recovery (see
# docs/guides/service-management.md). They are incomplete by definition and are not
# part of the platform.
dist.broken-root-*/

# Environment - never commit real secrets
.env
.env.local
.env.*.local
# Any backup or variant of a real .env: these carry JWT_SECRET, SECRETS_ROOT_KEY
# and DATABASE_URL, and a single accidental commit publishes them permanently.
.env.bak*
.env.*.bak
*.env.backup
# A plain copy of .env (e.g. `cp .env .env.save` before an edit) carries the same
# secrets as the file above and is just as publishable by accident.
.env.save
.env.save.*
!.env.example

# Runtime state (local development)
.runtime/
*.pid
*.log
logs/

# Test and coverage
coverage/
.nyc_output/

# Editors and OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Python (connector)
__pycache__/
*.py[cod]
.venv/
venv/

# Local workspaces created by the workspace manager
workspaces/

# Ad-hoc provider debug scripts left in backend/ during model-chain testing. They
# inline a provider key, so they must never be committed; delete them from a checkout
# rather than adding them to it.
backend/test-provider*.js

# Agent session state on the host the platform runs on: the operator's shell
# profile, tool caches, editor state, and the Hermes install that drives an agent
# session. None of it is part of the platform, and all of it is host-specific, so a
# fresh clone must not inherit it. (.runtime/ and logs above are already ignored.)
.hermes/
.9router/
.claude/
.claude.json
.cache/
.config/
.local/
.npm/
.bash_profile
.profile
.zshrc
.gitconfig
.agent-browser/

# The deployment's GitHub SSH key — never tracked
/.ssh/

# Root-built Next.js output moved aside; never tracked
frontend/.next.broken-root-*/

# Renamed-aside root-owned trees awaiting a root rm (see docs runbooks)
*.broken-root-*/
