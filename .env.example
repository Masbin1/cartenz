# =============================================================================
# LinkedERP AI Development Agent - environment contract
# =============================================================================
# Copy to .env and supply real values. Never commit .env.
#
# Variables marked REQUIRED have no default. The API refuses to start if they
# are absent or fail validation, so that a misconfigured deployment fails at
# boot rather than at the first request.
#
# Generate the two secret values with:
#   openssl rand -hex 32
#
# Any value containing a space must be quoted. The local development scripts
# source this file with the shell's "." builtin, which would otherwise read the
# remainder of the line as a command.
# =============================================================================

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
NODE_ENV=development

# -----------------------------------------------------------------------------
# API (NestJS)
# -----------------------------------------------------------------------------
API_PORT=4000
API_HOST=0.0.0.0
# Comma-separated list of browser origins permitted to call the API.
CORS_ORIGINS=http://localhost:3000

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
# REQUIRED. postgresql://user:password@host:port/database
DATABASE_URL=postgresql://linkederp:change-me@localhost:5432/linkederp_ai
DATABASE_POOL_MAX=10
DATABASE_SSL=false

# -----------------------------------------------------------------------------
# Redis (BullMQ queue and realtime pub/sub)
# -----------------------------------------------------------------------------
# REQUIRED. redis://[:password@]host:port/db
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# Authentication (ADR-015)
# -----------------------------------------------------------------------------
# REQUIRED. Minimum 32 characters. Rotating this invalidates all sessions.
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# -----------------------------------------------------------------------------
# Secrets provider (ADR-014)
# -----------------------------------------------------------------------------
# REQUIRED. Root key wrapping every per-project data key. 64 hex characters
# (32 bytes). Losing this makes every stored project credential unrecoverable.
SECRETS_ROOT_KEY=
# envelope | vault. Only "envelope" is implemented; "vault" is the target.
SECRETS_PROVIDER=envelope

# -----------------------------------------------------------------------------
# AI provider (Vercel AI SDK - provider-agnostic)
# -----------------------------------------------------------------------------
# These are the FALLBACK. Since ADR-023 an organisation sets its own provider in
# the portal at /settings, and its key is sealed by the secrets provider rather
# than living here. Prefer the portal: a key in this file is readable by anyone
# with the host, it ends up in backups, and rotating it means a restart.
#
# mock | openai-compatible | anthropic.
#
# "mock" binds the scripted provider: it runs the same loop and calls the same
# tools, but makes no network call and does no reasoning. Every plan it produces
# says so.
#
# Naming a real provider without AI_API_KEY is refused at boot, because the
# operator who sets this is not the person who will submit the task.
#
# Everything sent to a provider, and everything received, passes through the AI
# data boundary first (chapter 12, ADR-020). That is not configurable, here or in
# the portal.
AI_PROVIDER=openai-compatible
# Model id as the gateway knows it, e.g. cc/claude-sonnet-5, ds/deepseek-v4-flash.
AI_MODEL=ds/deepseek-v4-flash
# Base URL for a self-hosted, OpenAI-compatible endpoint. Required when
# AI_PROVIDER=openai-compatible, which is how a customer who forbids external AI
# is served by a local open-weight model behind the same interface.
AI_BASE_URL=http://127.0.0.1:20128/v1
# Provider API key. Leave blank for mock. Never commit a real key.
AI_API_KEY=sk-445d448ddf37a741-5tt3an-6e1d44a7
# Whether the endpoint enforces a JSON schema itself. true (default) uses
# response_format: json_schema (Claude, OpenAI). DeepSeek rejects json_schema, so
# set false to fall back to json_object mode with SDK-side schema validation.
AI_STRUCTURED_OUTPUTS=false

# How many times one provider is asked again when it answers with JSON that does
# not match the plan's schema, before the failover chain moves on. Counts the
# first attempt, so 1 disables retrying. Round-robin and cheap self-hosted
# endpoints occasionally answer an empty object even at temperature 0.
AI_STRUCTURED_MAX_ATTEMPTS=3

# -----------------------------------------------------------------------------
# Agent execution
# -----------------------------------------------------------------------------
# Multiplier on the simulated agent step delays. 0 runs the mock workflow as
# fast as the database allows, which is what the test suite uses.
AGENT_STEP_DELAY_MS=900
AGENT_WORKER_CONCURRENCY=4

# -----------------------------------------------------------------------------
# Frontend (Next.js). NEXT_PUBLIC_* values reach the browser: never place a
# secret here.
# -----------------------------------------------------------------------------
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000/ws

# -----------------------------------------------------------------------------
# Workspaces (Phase 2, ADR-019)
# -----------------------------------------------------------------------------
# Root under which each task clones its repository. Relative paths resolve from
# the repository root. This is the boundary every filesystem operation made by a
# tool is checked against.
WORKSPACE_ROOT=.runtime/workspaces
# Per-workspace quota. A clone or a write that would exceed either is refused.
WORKSPACE_MAX_BYTES=536870912
WORKSPACE_MAX_FILES=50000
# Retain a failed task's workspace for inspection. Refused in production: a
# retained clone is customer source code left on platform disk.
WORKSPACE_RETAIN_ON_FAILURE=false

# A clone per connected project, kept between tasks. Empty keeps the previous
# behaviour - nothing outlives its task. Set it and a project gets one clone,
# holding every branch, readable between tasks and synced on demand, so the
# code (and its history) is on this machine rather than re-fetched per task.
# This is customer source code resting on disk permanently, by design.
PROJECT_CHECKOUT_ROOT=
# Give each task a worktree of the project's clone instead of its own clone
# (default: on - the point of PROJECT_CHECKOUT_ROOT). Set false to roll back:
# every task clones for itself again, exactly as before this was added, while
# the project clone stays for reading and syncing.
PROJECT_CHECKOUT_REUSE=true

# On-premise execution (ADR-028)
# -----------------------------------------------------------------------------
# Base directory under which on-premise projects live, e.g.
# /home/masbintang/linkederp. Empty (default) disables on-premise execution: a
# task on an on_premise project is refused with an operator-actionable message.
ON_PREMISE_ROOT=
# Shared Odoo directories (base, enterprise) the agent may READ for dependency
# analysis and testing but must never modify. Comma-separated absolute paths;
# each becomes a read-only root whose prefix is its directory name, so the model
# references `odoo/addons/sale/...` rather than a host path.
ON_PREMISE_READ_ONLY_PATHS=

# Provisioning a real, running Odoo instance for a "Create with AI" project
# (ADR-039). Off by default, and refused at the process chokepoint (the same
# pattern as GIT_PUSH_ENABLED and VALIDATION_ENABLED) so it cannot be turned on
# by a permission or an approval alone. Enabling it lets the platform run the
# operator's own project-creation scripts as root via a narrow sudoers rule -
# see infrastructure/provisioning/99-linkederp-provisioning for what to install
# and infrastructure/provisioning/grant-addons-write.sh for the companion
# script that makes the result writable by this platform's own user.
PROJECT_PROVISIONING_ENABLED=false
# Absolute path to the Community project-creation script.
PROJECT_PROVISION_SCRIPT=/opt/odoo/scripts/create_project
# Absolute path to the Enterprise project-creation script.
PROJECT_PROVISION_SCRIPT_ENTERPRISE=/opt/odoo/scripts/create_project_enterprise
# Absolute path to the addons/ ownership fix-up script (see the file for why
# it exists: create_project chowns the whole project to odoo:odoo).
PROJECT_PROVISION_GRANT_SCRIPT=/opt/cartenz/infrastructure/provisioning/grant-addons-write.sh
# Absolute path to the project-pull script (ADR-049), which brings a provisioned
# instance up to date with the project's own repository. It is the script the
# platform's Deploy action runs as root, and it needs its own line in the same
# sudoers Cmnd_Alias as the three above. Empty disables the feature end to end:
# the process layer refuses the invocation and the portal does not offer it.
PROJECT_PULL_SCRIPT=/opt/cartenz/infrastructure/provisioning/pull-project.sh
# Absolute path to the per-client backup script (ADR-054), which snapshots a
# provisioned instance's database, filestore and addons repository before a push
# onto a staging (or main-named) branch. It needs its own line in the same
# sudoers Cmnd_Alias as the scripts above. Empty disables the feature end to
# end: the process layer refuses the invocation and a push proceeds without a
# restore point. The matching restore (restore-project.sh) is deliberately NOT
# in the sudoers rule - it is an operator's tool, run directly as root.
PROJECT_BACKUP_SCRIPT=/opt/cartenz/infrastructure/provisioning/backup-project.sh
# Absolute path to the project-restart script (ADR-057), which brings a
# provisioned instance onto a branch's tip AND serves it: it stops the unit,
# calls pull-project.sh unchanged, runs `odoo-bin -u all --stop-after-init`
# against the instance's own database, and starts the unit again - rolling the
# code back to the commit it was serving if the upgrade fails. It needs its own
# line in the same sudoers Cmnd_Alias as the scripts above. Empty disables the
# feature end to end: the process layer refuses the invocation and the portal
# does not offer it.
PROJECT_RESTART_SCRIPT=/opt/cartenz/infrastructure/provisioning/restart-project.sh
# The PROJECTS_DIR the scripts create project directories under. Must match
# BASE_DIR/projects inside those scripts exactly.
PROJECT_PROVISION_PROJECTS_DIR=/opt/odoo/projects
# The port range a new project's Odoo instance is allocated from. Each project
# takes two consecutive ports (HTTP, then HTTP+1 for gevent/websocket).
PROJECT_PORT_RANGE_START=7000
PROJECT_PORT_RANGE_END=7999
# The domain a provisioned project is reachable at: <project-name>.<this>.
# Leave empty to report http://127.0.0.1:<port> instead (no DNS/Nginx wired up).
PROJECT_BASE_DOMAIN=

# The ephemeral Odoo preview (ADR-052): a short-lived instance showing a task's
# draft so a reviewer sees the real UI before approving. It runs behind the same
# PROJECT_PROVISIONING_ENABLED switch and sudo grant as the scripts above, and it
# needs its own line in the same sudoers Cmnd_Alias. Empty disables it.
PROJECT_PREVIEW_SCRIPT=/opt/cartenz/infrastructure/provisioning/preview-project.sh
# Where the platform writes a preview's job file and patch for the root-run
# script to read. The script reads this fixed directory, never a path from its
# arguments.
PROJECT_PREVIEW_STAGING_DIR=/opt/cartenz/preview-staging
# How long a preview lives before it is torn down (milliseconds).
PROJECT_PREVIEW_TTL_MS=1800000
# The port range a preview's Odoo is allocated from (one port per preview).
PROJECT_PREVIEW_PORT_RANGE_START=8100
PROJECT_PREVIEW_PORT_RANGE_END=8199
# The domain a preview is served under: preview-<ref>.<this>. Empty falls back
# to PROJECT_BASE_DOMAIN, then to a loopback URL.
PROJECT_PREVIEW_BASE_DOMAIN=

# Issuing a real HTTPS certificate for a provisioned project's Nginx site
# (ADR-040), immediately after create_project/create_project_enterprise
# succeeds. Off by default and refused at the process chokepoint the same way
# as PROJECT_PROVISIONING_ENABLED. Requires PROJECT_PROVISIONING_ENABLED=true,
# a non-empty PROJECT_BASE_DOMAIN and a non-empty PROJECT_HTTPS_EMAIL - refused
# at boot otherwise. With this false, a provisioned project stays reachable
# over plain HTTP only.
PROJECT_HTTPS_ENABLED=false
# Absolute path to the HTTPS-issuance script (runs `certbot --nginx` for the
# project's own domain, non-interactively).
PROJECT_HTTPS_SCRIPT=/opt/cartenz/infrastructure/provisioning/setup-project-https.sh
# The email Let's Encrypt registers the certificate account under, for expiry
# notifications. Not a secret - passed as a plain certbot argument.
PROJECT_HTTPS_EMAIL=

# The Odoo source the agent reads as a reference on EVERY Odoo project, not only
# on-premise ones (ADR-031). Comma-separated absolute paths, typically the Odoo
# base checkout and the enterprise addons. Each becomes a read-only root whose
# prefix is its directory name, so the agent reads `odoo/addons/sale/...` and a
# write to it is refused by the platform.
#
# Left empty, the paths are derived from what a deployment configured for
# validation already has: ON_PREMISE_READ_ONLY_PATHS, ODOO_SHARED_ADDON_PATHS and
# the runtime paths in ODOO_RUNTIMES. Set it explicitly to have the reference
# without enabling validation.
#
# Superseded by the portal (ADR-033): once an organisation sets its Odoo paths in
# Settings, those are what the agent reads, and this is only the fallback for
# organisations that have not set them.
#
#   ODOO_SOURCE_PATHS=/opt/odoo,/opt/enterprise
ODOO_SOURCE_PATHS=

# The interpreter a validation run uses to start Odoo (ADR-034).
#
# Odoo needs a Python that can import it — on a normal deployment a virtualenv
# rather than the system interpreter. Defaults to `python3`.
#
#   ODOO_PYTHON=/home/user/venv/bin/python
ODOO_PYTHON=

# -----------------------------------------------------------------------------
# Git
# -----------------------------------------------------------------------------
# How much history a clone takes. 0 means the whole history; a positive value is
# the number of commits to fetch. Shallow by default: a task needs a branch and a
# diff, not history. Use 0 when the agent is expected to reason about how code
# came to look as it does - a shallow clone carries one commit and no past.
GIT_CLONE_DEPTH=1
GIT_AUTHOR_NAME="LinkedERP AI Agent"
GIT_AUTHOR_EMAIL=ai-agent@linkederp.com
# Permits file:// remotes. Off by default and refused in production, because a
# file:// remote can read any repository on the platform host. Exists so the
# test suite can clone without network access.
GIT_ALLOW_LOCAL_REMOTES=false

# -----------------------------------------------------------------------------
# Child process limits (enforced by CommandRunner; ADR-019)
# -----------------------------------------------------------------------------
PROCESS_TIMEOUT_MS=60000
PROCESS_MAX_TIMEOUT_MS=300000
PROCESS_MAX_OUTPUT_BYTES=8388608

# -----------------------------------------------------------------------------
# Tool output bounds, so one tool call cannot return a repository's worth of
# text to a model or to a browser.
# -----------------------------------------------------------------------------
CODE_SEARCH_MAX_RESULTS=60
CODE_SEARCH_MAX_FILE_BYTES=1048576
READ_FILE_MAX_BYTES=262144

# -----------------------------------------------------------------------------
# Model call bounds (Phase 3, ADR-020)
# -----------------------------------------------------------------------------
# These are what stop a task running until something else stops it. A loop that
# exhausts any of them ends the task in "failed" with the reason stated.
#
# A step is one model round trip; a step may contain several tool calls, which is
# why both are bounded.
# A flash-class model exploring an unfamiliar repository routinely needs more than
# the old 12 steps / 30 tool calls just to read the code before editing - tasks
# were failing with "the step budget of 12 was exhausted" having made no change.
# 30/60 sits well above a normal change (4-10 steps) while still bounding a loop
# that is not progressing.
AI_MAX_STEPS=30
AI_MAX_TOOL_CALLS=60
AI_MAX_OUTPUT_TOKENS=8000
AI_REQUEST_TIMEOUT_MS=120000
# Zero for the most deterministic output, which is what a code change wants.
AI_TEMPERATURE=0

# -----------------------------------------------------------------------------
# Push safety (ADR-021)
# -----------------------------------------------------------------------------
# The master switch for pushing to a customer repository. Off by default, and
# enforced by the process chokepoint refusing the git subcommand before the
# process is built.
#
# This is not a permission and not an approval. With this false, NO code path in
# the platform can push, whatever permission is granted or approval recorded.
# Phase 5 is therefore a configuration change an operator makes deliberately,
# not a simulation someone deletes.
GIT_PUSH_ENABLED=false

# SSH host key policy for git remotes reached over SSH, which is how Odoo.sh's
# native remote works.
#
#   yes         Correct. Requires a host key recorded on the connection.
#   accept-new  Trusts the first connection and records what it learned. A real
#               compromise, logged as one, and what most CI does.
#
# "no" is not offered: it accepts any host key and makes the connection trivially
# man-in-the-middleable.
GIT_SSH_HOST_KEY_POLICY=accept-new

# -----------------------------------------------------------------------------
# Pushing without a per-task approval, for non-production work (ADR-041)
# -----------------------------------------------------------------------------
# Off by default, and inert while GIT_PUSH_ENABLED=false (the process layer
# refuses the subcommand before an approval could matter).
#
# With both true, a task targeting a `development` or `staging` environment pushes
# as soon as it commits instead of waiting for a person to approve the push.
# `production` is not reachable this way: a task cannot target it at all - it is
# refused at task creation (ADR-021 s2). A task with no resolved environment keeps
# the approval. Every auto-approved push is recorded as task.push_auto_approved.
GIT_AUTO_PUSH_ON_TASK=false

# -----------------------------------------------------------------------------
# GitHub: the repository a created project is given (ADR-041)
# -----------------------------------------------------------------------------
# A project created here is scaffolded on this host and exists nowhere else, so
# GIT_PUSH_ENABLED alone changes nothing for it: there is no `origin` and no
# repository to receive a push. With these set, creating a project also creates its
# repository, points the project's repository at it, and pushes every branch.
#
#   GITHUB_TOKEN   A fine-grained PAT needing, for the owner below:
#                    Administration: read and write   (to create the repository)
#                    Contents:       read and write   (to push to it)
#                  Deployment credential. Never logged, never returned in a
#                  response, and sealed through the secrets store per project
#                  before any push uses it.
#   GITHUB_OWNER   The user or organisation that owns the created repositories. Not
#                  necessarily the account the token belongs to.
#
# All three are required: with the switch on and a token or owner missing, the
# feature is off rather than an error at project-creation time.
GITHUB_REPOSITORY_ENABLED=false
GITHUB_TOKEN=
GITHUB_OWNER=
# private (default) or public. A scaffold is the customer's code; a deployment that
# wants public repositories says so explicitly.
GITHUB_REPOSITORY_VISIBILITY=private

# -----------------------------------------------------------------------------
# Validation: running the repository's own Odoo modules (ADR-027)
# -----------------------------------------------------------------------------
# Off by default, and enforced at the process chokepoint. With this false the
# platform cannot start an Odoo process at all, whatever a project's permissions
# say. Enabling it is an operator decision about this host.
VALIDATION_ENABLED=false

# Which Odoo core serves which series. A consultancy host carries several, and a
# project whose series is not listed is skipped rather than run against another
# one — 18.0 code against a 19.0 core fails for reasons that have nothing to do
# with the change.
#
#   ODOO_RUNTIMES=19.0=/opt/odoo19,18.0=/opt/odoo18,17.0=/opt/odoo17
ODOO_RUNTIMES=

# Addon directories shared across every series: enterprise, OCA, and so on. The
# project's own addons come from the task's workspace, never the live directory.
ODOO_SHARED_ADDON_PATHS=

# The Postgres role validation runs as. This must NOT be the Odoo role.
#
# On a typical on-premise host the Odoo role is a Postgres superuser owning every
# customer database, and an Odoo test run is not a read: it creates a database,
# installs modules and runs code that writes. Create a role for validation with
# CREATEDB and nothing else, and revoke CONNECT on the customer databases:
#
#   CREATE ROLE linkederp_validation LOGIN CREATEDB PASSWORD '...';
#   REVOKE CONNECT ON DATABASE "<each-odoo-db>" FROM PUBLIC;
#
# GET /health/posture reports whether that has been done.
VALIDATION_DB_USER=
VALIDATION_DB_PASSWORD=

# A run that has not finished by here is killed. Installing modules is slow.
VALIDATION_TIMEOUT_MS=900000

# Where validation reaches Postgres. Separate from DATABASE_URL because they are
# not the same connection: the platform's own database may be elsewhere, and the
# one that matters here is the cluster Odoo uses.
VALIDATION_DB_HOST=127.0.0.1
VALIDATION_DB_PORT=5432

# -----------------------------------------------------------------------------
# Pointing the whole server at one gateway (ADR-023)
# -----------------------------------------------------------------------------
# On a consultancy server the usual arrangement is a token manager or router
# holding the vendor keys and exposing one OpenAI-compatible endpoint. Set it
# here and every organisation inherits it: nobody pastes a key into the portal,
# and there is one place to rotate.
#
#   AI_PROVIDER=openai-compatible
#   AI_BASE_URL=http://127.0.0.1:20128/v1     the router, on this machine
#   AI_MODEL=Paket-Hemat                       whichever model it serves
#   AI_API_KEY=<the router's own key>
#
# Plain http is accepted only for a gateway on this machine. Anywhere else the
# prompt carries repository source code and the key travels with it, so https is
# required — the same rule the portal applies.
#
# An organisation that needs its own provider or its own billing can still
# override this in the portal. The environment is the default, not a ceiling.
